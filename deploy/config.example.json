{
  "listen": "0.0.0.0:8443",

  "tls": {
    "cert_file": "/etc/gripline/tls/cert.pem",
    "key_file": "/etc/gripline/tls/key.pem",
    "min_version": "1.3"
  },

  "backend": {
    "url": "https://provider.internal:443",
    "timeout": "30s",
    "dial_timeout": "5s",
    "tls_handshake_timeout": "5s",
    "response_header_timeout": "20s",
    "max_idle_conns_per_host": 64,
    "max_response_header_bytes": 65536,
    "allowed_endpoints": [
      {"method": "POST", "path": "/v1/messages", "required_scope": "inference"},
      {"method": "POST", "path": "/v1/responses", "required_scope": "inference"},
      {"method": "POST", "path": "/v1/chat/completions", "required_scope": "inference"},
      {"method": "POST", "path": "/v1/completions", "required_scope": "inference"},
      {"method": "POST", "path": "/v1/embeddings", "required_scope": "inference"},
      {"method": "GET", "path": "/v1/models", "required_scope": "inference"}
    ]
  },

  "server": {
    "read_timeout": "30s",
    "write_timeout": "60s",
    "idle_timeout": "120s",
    "max_connections": 4096,
    "http2_max_concurrent_streams": 100,
    "http2_header_table_bytes": 4096,
    "http2_max_read_frame_bytes": 1048576,
    "read_header_timeout": "10s",
    "max_header_bytes": 65536,
    "max_body_bytes": 33554432,
    "stream_write_idle_timeout": "30s",
    "preauth_max_concurrent": 1024,
    "preauth_requests_per_second": 2000,
    "preauth_source_requests_per_second": 100,
    "preauth_max_sources": 10000,
    "spool_dir": "/tmp/gripline-spool",
    "spool_max_bytes": 67108864,
    "spool_max_files": 32
  },

  "admin": {
    "listen": "127.0.0.1:9090",
    "operator_tokens": {
      "${GRIPLINE_OPERATOR_TOKEN}": "ops:posture.control,credential.lifecycle,lane.lifecycle,evidence.operator,policy.install,audit.read"
    }
  },

  "identity": {
    "audience": "gripline-inference"
  },

  "secrets": {
    "pepper_versions": {
      "1": "${GRIPLINE_PEPPER_V1}"
    }
  },

  "ingress": {
    "pseudonym_key": "${GRIPLINE_PSEUDONYM_KEY}",
    "trusted_proxies": ["10.0.0.0/8"]
  },

  "usage": {
    "mode": "none",
    "input_microunits_per_token": 0,
    "output_microunits_per_token": 0,
    "default_output_tokens": 0,
    "max_output_tokens": 4096
  },

  "paths": {
    "state": "/var/lib/gripline/state.db",
    "signer_keyring": "/var/lib/gripline/keyring.json"
  },

  "deployment": {}
}
